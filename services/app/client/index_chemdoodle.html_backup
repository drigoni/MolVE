<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1" />
    <title>Molecular Evaluation Platform</title>
    <!-- Include 3Dmol.js library as specified -->
    <script src="https://3Dmol.org/build/3Dmol-min.js"></script>
    <script
      type="text/javascript"
      src="/ChemDoodleWeb-11.0.0/install/ChemDoodleWeb.js"
    ></script>
    <script
      type="text/javascript"
      src="/ChemDoodleWeb-11.0.0/install/ChemDoodleWeb-uis.js"
    ></script>
    <link rel="stylesheet" href="/ChemDoodleWeb-11.0.0/install/ChemDoodleWeb.css">
    <script type="text/javascript" src="/JSmol/JSmol.min.js"></script>
    <!-- <script type="text/javascript" src="https://chemapps.stolaf.edu/jmol/jsmol/JSmol.min.js"></script> -->
    <script>
      window.addEventListener('load', function() {
        if (window.$3Dmol) {
          console.log('3Dmol.js loaded successfully');
        } else {
          console.error('3Dmol.js failed to load');
        }
      });
      window.addEventListener('load', function() {
        if (ChemDoodle) {
          console.log('ChemDoodle.js loaded successfully');
        } else {
          console.error('ChemDoodle.js failed to load');
        }
      });
      window.addEventListener('load', function() {
        if (Jmol) {
          console.log('JSmol.js loaded successfully');
        } else {
          console.error('JSmol.js failed to load');
        }
      });
    </script>
  </head>
  <body>
    <div id="root"></div>
    <script type="module" src="/src/main.tsx"></script>
  </body>
</html>